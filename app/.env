# LOCAL DEVELOPMENT ONLY
# ----------------------
# This file is gitignored and is NOT baked into the Docker image.
# In the cluster, these values are injected at runtime as env vars from
# AWS Secrets Manager (secret: django-api/uat/db-credentials) via the
# Secrets Store CSI driver. Do not commit real secrets here.
#
# For local runs, point DB_HOST at a reachable database (e.g. a local
# Postgres or an SSH tunnel to RDS). The values below match the UAT RDS
# schema (user/name/port) but use a local-friendly host by default.

DB_HOST=localhost
DB_USER=dbadmin
DB_PASSWORD=change-me-locally
DB_NAME=appdb
DB_PORT=5432
